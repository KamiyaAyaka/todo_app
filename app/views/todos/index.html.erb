<div class="container">
    <h1>Todo List</h1>

    <%= link_to 'ToDoの作成', new_todo_path %>
    <%= link_to '完了したタスク', completed_todos_path %>

    <table>
        <thead>
            <tr>
                <th>チェック</th>
                <th>タスク</th>
                <th>アクション</th>
            </tr>
        </thead>
        <tbody>
            <% @todos.each do |todo| %>
                <tr>
                    <%= form_with model: todo do |f| %>
                        <td><%= f.check_box :completed %></td>
                        <td><%= todo.title %></td>
                        <td><%= f.submit '完了' %></td>
                    <% end %>
                    <td>
                        <%= link_to '詳細', todo_path(todo) %>
                        <%= link_to '編集する', edit_todo_path(todo) %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>